{
  "name": "warzone-rts",
  "version": "1.0.0",
  "description": "3D Military RTS Game",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:mp": "node server-multiplayer.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:armor": "node scripts/verify-armored-vehicles.mjs",
    "test:interface": "node scripts/verify-interface.mjs",
    "test:roster": "node scripts/verify-roster.mjs",
    "test:camera": "node scripts/verify-camera.mjs",
    "test:environment": "node scripts/verify-environment.mjs",
    "test:performance": "node scripts/verify-performance.mjs",
    "test:batching": "node scripts/verify-unit-batching.mjs",
    "test:vfx": "node scripts/verify-vfx.mjs",
    "test:audio": "node scripts/verify-audio.mjs",
    "analyze:assets": "node scripts/analyze-roster-budget.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "three": "^0.183.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
